# Spirit Furnace@@name_suffix@@ - wezterm
# place in ~/.config/wezterm/colors/, then: config.color_scheme = "Spirit Furnace@@name_suffix@@"

[metadata]
name = "Spirit Furnace@@name_suffix@@"
author = "Sam Lightbody"

[colors]
foreground = "#@@text@@"
background = "#@@base@@"
cursor_bg = "#@@cursor@@"
cursor_fg = "#@@base@@"
cursor_border = "#@@cursor@@"
selection_fg = "#@@b_white7@@"
selection_bg = "#@@selection@@"
ansi = ["#@@border@@", "#@@tribulation@@", "#@@herb@@", "#@@elixir@@", "#@@heaven@@", "#@@blossom@@", "#@@jade@@", "#@@b_white7@@"]
brights = ["#@@b_black@@", "#@@b_red@@", "#@@b_green@@", "#@@b_yellow@@", "#@@b_blue@@", "#@@b_magenta@@", "#@@b_cyan@@", "#@@text@@"]
