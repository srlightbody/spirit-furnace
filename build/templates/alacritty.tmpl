# Spirit Furnace@@name_suffix@@ - alacritty (0.13+)
# spirit furnace: mineral pigments over a furnace-lit dark

[colors.primary]
background = "#@@base@@"
foreground = "#@@text@@"

[colors.cursor]
text   = "#@@base@@"
cursor = "#@@cursor@@"

[colors.selection]
text       = "#@@b_white7@@"
background  = "#@@selection@@"

[colors.normal]
black   = "#@@border@@"
red     = "#@@tribulation@@"
green   = "#@@herb@@"
yellow  = "#@@elixir@@"
blue    = "#@@heaven@@"
magenta = "#@@blossom@@"
cyan    = "#@@jade@@"
white   = "#@@b_white7@@"

[colors.bright]
black   = "#@@ash@@"
red     = "#@@b_red@@"
green   = "#@@b_green@@"
yellow  = "#@@b_yellow@@"
blue    = "#@@b_blue@@"
magenta = "#@@b_magenta@@"
cyan    = "#@@b_cyan@@"
white   = "#@@text@@"
