# Spirit Furnace@@name_suffix@@ - k9s skin
# place in ~/.config/k9s/skins/@@slug@@.yaml, then set in config.yaml:
#   k9s:
#     ui:
#       skin: @@slug@@

k9s:
  body:
    fgColor: "#@@text@@"
    bgColor: "#@@base@@"
    logoColor: "#@@core@@"
  prompt:
    fgColor: "#@@text@@"
    bgColor: "#@@base@@"
    suggestColor: "#@@furnace@@"
  info:
    fgColor: "#@@core@@"
    sectionColor: "#@@text@@"
  dialog:
    fgColor: "#@@text@@"
    bgColor: "#@@base@@"
    buttonFgColor: "#@@base@@"
    buttonBgColor: "#@@core@@"
    buttonFocusFgColor: "#@@base@@"
    buttonFocusBgColor: "#@@herb@@"
    labelFgColor: "#@@elixir@@"
    fieldFgColor: "#@@text@@"
  frame:
    border:
      fgColor: "#@@border@@"
      focusColor: "#@@jade@@"
    menu:
      fgColor: "#@@text@@"
      keyColor: "#@@furnace@@"
      numKeyColor: "#@@furnace@@"
    crumbs:
      fgColor: "#@@base@@"
      bgColor: "#@@ash@@"
      activeColor: "#@@core@@"
    status:
      newColor: "#@@core@@"
      modifyColor: "#@@heaven@@"
      addColor: "#@@herb@@"
      errorColor: "#@@tribulation@@"
      highlightColor: "#@@elixir@@"
      killColor: "#@@furnace@@"
      completedColor: "#@@ash@@"
    title:
      fgColor: "#@@text@@"
      bgColor: "#@@base@@"
      highlightColor: "#@@elixir@@"
      counterColor: "#@@furnace@@"
      filterColor: "#@@core@@"
  views:
    charts:
      bgColor: "#@@base@@"
      defaultDialColors:
        - "#@@core@@"
        - "#@@tribulation@@"
      defaultChartColors:
        - "#@@core@@"
        - "#@@tribulation@@"
    table:
      fgColor: "#@@text@@"
      bgColor: "#@@base@@"
      cursorFgColor: "#@@text@@"
      cursorBgColor: "#@@selection@@"
      header:
        fgColor: "#@@text@@"
        bgColor: "#@@base@@"
        sorterColor: "#@@herb@@"
    xray:
      fgColor: "#@@text@@"
      bgColor: "#@@base@@"
      cursorColor: "#@@selection@@"
      graphicColor: "#@@core@@"
    yaml:
      keyColor: "#@@heaven@@"
      colonColor: "#@@incense@@"
      valueColor: "#@@text@@"
    logs:
      fgColor: "#@@text@@"
      bgColor: "#@@base@@"
      indicator:
        fgColor: "#@@core@@"
        bgColor: "#@@base@@"
