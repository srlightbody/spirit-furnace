# Spirit Furnace@@name_suffix@@ - lazygit
# Keep this as a standalone file and layer it over your config via LG_CONFIG_FILE:
#   export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/@@slug@@.yml"
# (rightmost wins) so theme updates never touch your personal config.

gui:
  theme:
    activeBorderColor:
      - "#@@core@@"
      - bold
    inactiveBorderColor:
      - "#@@ash@@"
    searchingActiveBorderColor:
      - "#@@elixir@@"
      - bold
    optionsTextColor:
      - "#@@heaven@@"
    selectedLineBgColor:
      - "#@@border@@"
    cherryPickedCommitFgColor:
      - "#@@core@@"
    cherryPickedCommitBgColor:
      - "#@@hl_med@@"
    markedBaseCommitFgColor:
      - "#@@elixir@@"
    markedBaseCommitBgColor:
      - "#@@hl_med@@"
    unstagedChangesColor:
      - "#@@tribulation@@"
    defaultFgColor:
      - "#@@text@@"
  authorColors:
    "*": "#@@furnace@@"
