# Spirit Furnace@@name_suffix@@ - lsd
# place at ~/.config/lsd/colors.yaml (lsd reads it directly), or point lsd at it.

user: "#@@elixir@@"
group: "#@@ash@@"
permission:
  read: "#@@blossom@@"
  write: "#@@elixir@@"
  exec: "#@@tribulation@@"
  exec-sticky: "#@@furnace@@"
  no-access: "#@@ash@@"
  octal: "#@@core@@"
  acl: "#@@core@@"
  context: "#@@furnace@@"
date:
  hour-old: "#@@core@@"
  day-old: "#@@core@@"
  older: "#@@ash@@"
size:
  none: "#@@ash@@"
  small: "#@@blossom@@"
  medium: "#@@elixir@@"
  large: "#@@tribulation@@"
inode:
  valid: "#@@furnace@@"
  invalid: "#@@ash@@"
links:
  valid: "#@@furnace@@"
  invalid: "#@@ash@@"
tree-edge: "#@@border@@"
git-status:
  default: "#@@text@@"
  unmodified: "#@@ash@@"
  ignored: "#@@ash@@"
  new-in-index: "#@@herb@@"
  new-in-workdir: "#@@herb@@"
  typechange: "#@@elixir@@"
  deleted: "#@@tribulation@@"
  modified: "#@@elixir@@"
  renamed: "#@@core@@"
  conflicted: "#@@tribulation@@"
