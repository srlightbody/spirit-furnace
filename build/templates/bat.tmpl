<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Spirit Furnace@@name_suffix@@</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>#@@base@@</string>
				<key>foreground</key>
				<string>#@@text@@</string>
				<key>caret</key>
				<string>#@@herb@@</string>
				<key>lineHighlight</key>
				<string>#@@inactive_tab@@</string>
				<key>selection</key>
				<string>#@@selection@@</string>
				<key>gutterForeground</key>
				<string>#@@ash@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>comment, punctuation.definition.comment</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@incense@@</string>
				<key>fontStyle</key>
				<string>italic</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>string, string.quoted, constant.other.symbol</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@elixir@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>constant.numeric, constant.other, constant.character</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@elixir@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>constant.language</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@jade@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>keyword, keyword.control, keyword.other</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@heaven@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>keyword.operator, punctuation</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@incense@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>variable.other.member, variable.other.property, variable.other.object.property, support.type.property-name, meta.mapping.key, entity.name.tag.yaml, variable.declaration.hcl</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@member@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>storage, storage.type, storage.modifier</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@blossom@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>entity.name.function, support.function</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@jade@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>entity.name.type, entity.name.class, entity.name.namespace, support.type, support.class</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@blossom@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>variable, variable.other</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@text@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>variable.parameter</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@furnace@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>entity.name.tag</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@blossom@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>entity.other.attribute-name</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@furnace@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>markup.inserted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@herb@@</string>
			</dict>
		</dict>
		<dict>
			<key>scope</key>
			<string>markup.deleted</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#@@tribulation@@</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
