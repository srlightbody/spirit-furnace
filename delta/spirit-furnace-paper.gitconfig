# Spirit Furnace Paper - delta
# include from ~/.gitconfig:
#   [include]
#       path = ~/.config/delta/spirit-furnace-paper.gitconfig
# syntax-theme expects spirit-furnace-paper.tmTheme on the bat themes path (bat names themes
# by file stem).

[delta]
	syntax-theme = spirit-furnace-paper
	line-numbers = true

	minus-style = syntax "#bc906b"
	minus-emph-style = syntax "#b47756"
	plus-style = syntax "#a3a06b"
	plus-emph-style = syntax "#8c9156"

	line-numbers-minus-style = "#951300"
	line-numbers-plus-style = "#305400"
	line-numbers-zero-style = "#7c6c56"
	line-numbers-left-style = "#ae9d70"
	line-numbers-right-style = "#ae9d70"

	file-style = "#683f4c" bold
	file-decoration-style = "#ae9d70" ul
	hunk-header-style = "#7b3600" bold
	hunk-header-decoration-style = "#ae9d70" box

	zero-style = syntax
	whitespace-error-style = "#951300" reverse
